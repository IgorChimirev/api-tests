#!/bin/sh

# Показываем ЧЕРЕМШУ через Quick Look + громкий звук
REPO_ROOT=$(git rev-parse --show-toplevel)
IMAGE="$REPO_ROOT/download.jpg"

osascript -e "set volume output volume 100" 2>/dev/null
osascript -e 'beep 5' &
osascript << EOF &
tell application "Preview"
    activate
    open POSIX file "$IMAGE"
    delay 1
    tell application "System Events"
        keystroke "f" using {control down, command down}
    end tell
end tell
EOF

# Запускаем тесты
echo "Запускаем тесты перед пушем..."
go test ./...

if [ $? -ne 0 ]; then
  echo "Тесты упали. Пуш отменён."
  exit 1
fi

echo "Все тесты прошли. Пуш продолжается. 🚀"
